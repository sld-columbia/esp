proc set_io_standard {standard ports} {
    foreach port $ports {
        set_instance_assignment -name IO_STANDARD $standard -to $port
    }
}

proc set_current_strength {strength ports} {
    foreach port $ports {
        set_instance_assignment -name CURRENT_STRENGTH_NEW $strength -to $port
    }
}

proc set_weak_pull_up {ports} {
    foreach port $ports {
        set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to $port
    }
}

proc set_pin_locations {pin_port_pairs} {
    foreach {pin port} $pin_port_pairs {
        set_location_assignment $pin -to $port
    }
}

